  {
    "name": "duration in seconds and font weight keywords decode",
    "mutations": [
      {
        "path": [
          "demo",
          "motion",
          "fade",
          "$value"
        ],
        "operation": "set",
        "value": {
          "value": 0.25,
          "unit": "s"
        }
      },
      {
        "path": [
          "demo",
          "type",
          "weight",
          "$value"
        ],
        "operation": "set",
        "value": "semi-bold"
      }
    ],
    "expected": "valid",
    "values": {
      "demo.motion.fade": {
        "value": 250,
        "unit": "ms"
      },
      "demo.type.weight": 600
    }
  },
  {
    "name": "group type is inherited",
    "mutations": [
      {
        "path": [
          "demo",
          "density",
          "$type"
        ],
        "operation": "set",
        "value": "dimension"
      },
      {
        "path": [
          "demo",
          "density",
          "gap",
          "$type"
        ],
        "operation": "remove"
      }
    ],
    "expected": "valid",
    "values": {
      "demo.density.gap": {
        "value": 0.75,
        "unit": "rem"
      }
    }
  },
  {
    "name": "px on a foundation token flows through aliases",
    "mutations": [
      {
        "path": [
          "shape",
          "medium",
          "$value"
        ],
        "operation": "set",
        "value": {
          "value": 6,
          "unit": "px"
        }
      },
      {
        "path": [
          "shape",
          "medium",
          "$extensions"
        ],
        "operation": "remove"
      }
    ],
    "expected": "valid",
    "values": {
      "demo.shape.card": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  {
    "name": "a single shadow object is accepted",
    "mutations": [
      {
        "path": [
          "demo",
          "depth",
          "cardShadow",
          "$value"
        ],
        "operation": "set",
        "value": {
          "color": "{colors.shadow}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 3,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    ],
    "expected": "valid",
    "values": {
      "demo.depth.cardShadow": [
        {
          "color": "{colors.shadow}",
          "offsetX": {
            "value": 0,
            "unit": "dp"
          },
          "offsetY": {
            "value": 1,
            "unit": "dp"
          },
          "blur": {
            "value": 3,
            "unit": "dp"
          },
          "spread": {
            "value": 0,
            "unit": "dp"
          }
        }
      ]
    }
  },
  {
    "name": "app extension is required",
