    "depth": {
      "card": {
        "$type": "number",
        "$description": "Card elevation level.",
        "$value": 1.0
      },
      "cardShadow": {
        "$type": "shadow",
        "$description": "Card shadow.",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0.0,
                0.0,
                0.0
              ],
              "alpha": 0.2
            },
            "offsetX": {
              "value": 0.0,
              "unit": "px"
            },
            "offsetY": {
              "value": 2.0,
              "unit": "px"
            },
            "blur": {
              "value": 6.0,
              "unit": "px"
            },
            "spread": {
              "value": 0.0,
              "unit": "px"
            }
          },
          {
            "color": "{colors.shadow}",
            "offsetX": {
              "value": 0.0,
              "unit": "px"
            },
            "offsetY": "{shape.extraSmall}",
            "blur": {
              "value": 1.0,
              "unit": "px"
            },
            "spread": {
              "value": -1.0,
              "unit": "px"
            },
            "inset": true
          }
        ],
        "$extensions": {
          "dev.aurora": {
            "unit": "dp"
          }
        }
      }
    },
    "lines": {
      "divider": {
        "$type": "strokeStyle",
        "$description": "Divider stroke style.",
        "$value": {
          "dashArray": [
            {
              "value": 4.0,
              "unit": "px"
            },
            "{shape.extraSmall}"
          ],
          "lineCap": "round"
        },
        "$extensions": {
          "dev.aurora": {
            "unit": "dp"
          }
        }
      },
      "rule": {
        "$type": "strokeStyle",
        "$description": "Rule stroke style.",
        "$value": "dashed"
      },
      "hidden": {
        "$type": "strokeStyle",
        "$description": "A stroke that draws nothing.",
        "$value": {
          "dashArray": [
            {
              "value": 0,
              "unit": "px"
            }
          ],
          "lineCap": "butt"
        }
      },
      "cardBorder": {
        "$type": "border",
        "$description": "Card border.",
        "$value": {
          "color": "{colors.outlineVariant}",
          "width": {
            "value": 1.5,
            "unit": "px"
          },
          "style": "{demo.lines.rule}"
        },
        "$extensions": {
          "dev.aurora": {
            "unit": "dp"
          }
        }
      },
      "bordered": {
        "$description": "Whether cards draw a border.",
        "$value": true,
        "$extensions": {
          "dev.aurora": {
            "type": "boolean"
          }
        }
      }
    },
    "variants": {
      "card": {
        "$description": "Default card layout.",
        "$value": "walletPass",
        "$extensions": {
          "dev.aurora": {
            "type": "enum",
            "values": [
              "rich",
              "compact",
              "walletPass"
