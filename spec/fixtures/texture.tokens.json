      "$value": {
        "value": 500.0,
        "unit": "ms"
      }
    },
    "extraLong": {
      "$type": "duration",
      "$description": "Duration of slow, emphasized transitions.",
      "$value": {
        "value": 800.0,
        "unit": "ms"
      }
    },
