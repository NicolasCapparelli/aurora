    "motion": {
      "fade": {
        "$type": "duration",
        "$description": "Fade duration.",
        "$value": {
          "value": 200.0,
          "unit": "ms"
        }
      },
      "ease": {
        "$type": "cubicBezier",
        "$description": "Fade easing.",
        "$value": "{motion.easing.standard}"
      }
    }
