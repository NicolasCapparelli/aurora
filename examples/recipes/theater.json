{
  "schemaVersion": 1,
  "id": "wicked",
  "name": "Wicked",
  "primary": "#246b35",
  "appearance": "both",
  "preferredAppearance": "dark",
  "contract": {
    "id": "theater",
    "version": 1,
    "extensions": [
      {"path": "theater.ticketBackground", "description": "Background of a theater ticket."},
      {"path": "theater.onTicket", "description": "Text on a theater ticket."}
