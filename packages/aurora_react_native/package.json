{
  "name": "@aurora/react-native",
  "version": "0.1.0",
  "description": "React Native adapter for Aurora: controller, provider, fixed scopes, hooks and explicit native style conversions.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@aurora/core": "0.1.0",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@aurora/core": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
